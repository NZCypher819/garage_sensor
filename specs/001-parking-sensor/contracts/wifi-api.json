{
  "openapi": "3.0.0",
  "info": {
    "title": "WiFi and OTA Management Interface",
    "version": "1.0.0", 
    "description": "Network connectivity and over-the-air update interface contracts"
  },
  "paths": {
    "/api/v1/status": {
      "get": {
        "summary": "Get device status",
        "responses": {
          "200": {
            "description": "Current device status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/config": {
      "get": {
        "summary": "Get device configuration",
        "responses": {
          "200": {
            "description": "Current device configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceConfig"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update device configuration",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceConfig"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Configuration updated successfully"
          },
          "400": {
            "description": "Invalid configuration"
          }
        }
      }
    },
    "/api/v1/ota/check": {
      "post": {
        "summary": "Check for firmware updates",
        "responses": {
          "200": {
            "description": "Update status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OTAStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ota/update": {
      "post": {
        "summary": "Initiate firmware update",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OTARequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Update initiated"
          },
          "400": {
            "description": "Invalid update request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "WiFiStatus": {
        "type": "object",
        "required": ["connected", "ssid", "signal_strength", "ip_address"],
        "properties": {
          "connected": {
            "type": "boolean",
            "description": "WiFi connection status"
          },
          "ssid": {
            "type": "string",
            "description": "Connected network name"
          },
          "signal_strength": {
            "type": "integer",
            "minimum": -100,
            "maximum": 0,
            "description": "WiFi signal strength in dBm"
          },
          "ip_address": {
            "type": "string",
            "format": "ipv4",
            "description": "Assigned IP address"
          },
          "mac_address": {
            "type": "string",
            "pattern": "^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$",
            "description": "Device MAC address"
          },
          "connection_time": {
            "type": "string",
            "format": "date-time",
            "description": "When connection was established"
          }
        }
      },
      "DeviceStatus": {
        "type": "object",
        "required": ["device_id", "firmware_version", "uptime_seconds", "operational_state"],
        "properties": {
          "device_id": {
            "type": "string",
            "description": "Unique device identifier"
          },
          "firmware_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Current firmware version (semantic versioning)"
          },
          "uptime_seconds": {
            "type": "integer",
            "minimum": 0,
            "description": "Time since last boot"
          },
          "operational_state": {
            "type": "string",
            "enum": ["initializing", "ready", "low_power", "fault", "updating"],
            "description": "Current operational state"
          },
          "free_memory_bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "Available heap memory"
          },
          "wifi": {
            "$ref": "#/components/schemas/WiFiStatus"
          },
          "last_seen": {
            "type": "string",
            "format": "date-time",
            "description": "Last status update timestamp"
          }
        }
      },
      "DeviceConfig": {
        "type": "object",
        "required": ["device_id", "led_brightness", "power_save_timeout"],
        "properties": {
          "device_id": {
            "type": "string",
            "description": "Device identifier"
          },
          "led_brightness": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "description": "LED PWM brightness level"
          },
          "power_save_timeout": {
            "type": "integer",
            "minimum": 10,
            "maximum": 3600,
            "description": "Idle timeout before low power mode (seconds)"
          },
          "sensor_debounce_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Sensor debouncing duration"
          },
          "response_time_target": {
            "type": "integer",
            "minimum": 10,
            "maximum": 500,
            "description": "Target response time in milliseconds"
          },
          "log_level": {
            "type": "string",
            "enum": ["debug", "info", "warn", "error"],
            "description": "Logging verbosity level"
          },
          "telemetry_enabled": {
            "type": "boolean",
            "description": "Enable remote telemetry"
          }
        }
      },
      "OTAStatus": {
        "type": "object",
        "required": ["update_available", "current_version"],
        "properties": {
          "update_available": {
            "type": "boolean",
            "description": "Whether firmware update is available"
          },
          "current_version": {
            "type": "string",
            "description": "Currently installed firmware version"
          },
          "latest_version": {
            "type": "string",
            "description": "Latest available firmware version"
          },
          "download_url": {
            "type": "string",
            "format": "uri",
            "description": "URL to download update"
          },
          "update_size_bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "Size of update file"
          },
          "release_notes": {
            "type": "string",
            "description": "Update description and changelog"
          }
        }
      },
      "OTARequest": {
        "type": "object",
        "required": ["target_version", "download_url"],
        "properties": {
          "target_version": {
            "type": "string",
            "description": "Firmware version to install"
          },
          "download_url": {
            "type": "string",
            "format": "uri",
            "description": "URL to download firmware"
          },
          "checksum": {
            "type": "string",
            "description": "Expected SHA256 checksum of firmware file"
          },
          "force_update": {
            "type": "boolean",
            "description": "Force update even if version appears older"
          }
        }
      },
      "SecurityConfig": {
        "type": "object",
        "required": ["https_enabled", "cert_validation"],
        "properties": {
          "https_enabled": {
            "type": "boolean",
            "description": "Whether HTTPS is enabled for OTA updates"
          },
          "cert_validation": {
            "type": "boolean", 
            "description": "Whether to validate server certificates"
          },
          "root_ca_fingerprint": {
            "type": "string",
            "description": "SHA256 fingerprint of expected root CA"
          },
          "download_timeout_seconds": {
            "type": "integer",
            "minimum": 30,
            "maximum": 600,
            "description": "Timeout for firmware downloads"
          },
          "integrity_check_enabled": {
            "type": "boolean",
            "description": "Whether to perform file integrity validation"
          },
          "rollback_enabled": {
            "type": "boolean",
            "description": "Whether automatic rollback is enabled"
          }
        }
      }
    }
  }
}